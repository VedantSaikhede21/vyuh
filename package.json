{
  "name": "vyuh",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "seed": "pnpm --filter @vyuh/api seed",
    "seed:reset-demo": "pnpm --filter @vyuh/api seed:reset-demo",
    "guests:cleanup": "pnpm --filter @vyuh/api guests:cleanup",
    "study:enrol": "pnpm --filter @vyuh/api study:enrol",
    "lint": "pnpm lint:ts && pnpm --filter @vyuh/api lint",
    "lint:ts": "eslint . && prettier --check . && pnpm --filter @vyuh/web lint && pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "test": "pnpm -r --filter \"./packages/*\" --filter @vyuh/web test",
    "gen:schemas": "pnpm --filter @vyuh/shared export:jsonschema && pnpm --filter @vyuh/api gen:pydantic",
    "e2e": "pnpm --filter @vyuh/web e2e",
    "gen:hillshade": "node scripts/hillshade/gen-hillshade.ts --preset JK_MOUNTAIN --out apps/web/public/landing/login-hillshade.png --size 1200 --tone login",
    "gen:maps": "node scripts/hillshade/gen-hillshade.ts --all",
    "sweep:generator": "node scripts/generator/sweep.ts",
    "graph": "graphify update ."
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
