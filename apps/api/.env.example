# VYUH API environment — this file is the contract (CLAUDE.md §11).
# Copy to `.env` and fill in. Never commit `.env`.

# dev | prod | offline
ENV=dev

# Postgres connection string. Local: `docker compose up -d` from the repo root.
DATABASE_URL=postgresql+psycopg://vyuh:vyuh@localhost:5432/vyuh

# local (HS256 with LOCAL_JWT_SECRET, works offline) | supabase (JWKS verification)
AUTH_MODE=local

# Supabase (only when AUTH_MODE=supabase). JWKS URL defaults to
# $SUPABASE_URL/auth/v1/.well-known/jwks.json. The project must use asymmetric JWT signing keys.
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# Required when AUTH_MODE=local: at least 32 bytes. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
LOCAL_JWT_SECRET=

# Comma-separated web origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# LLM (Phase 5). false = templates only, no network calls.
LLM_ENABLED=false
LLM_PROVIDER=openrouter
LLM_MODEL=google/gemini-3.8-flash
# OpenAI-compatible chat API root (default OpenRouter; a local server works offline)
LLM_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
LLM_TIMEOUT_S=20
LLM_RATE_LIMIT_PER_MIN=10

# Live weather via Open-Meteo (cached; keep false offline)
OPEN_METEO_ENABLED=false

# Guest demo mode (Phase 6)
GUEST_MODE_ENABLED=false
GUEST_TTL_HOURS=24

LOG_LEVEL=INFO

# POST /scenarios/generate calls per user per minute (in-memory limit)
GENERATE_RATE_LIMIT_PER_MIN=10

# Terrain presets read by the scenario generator (meta.json, heightmap.u16,
# buildings.geojson per preset). Default: the repo's apps/web/public/terrain.
# The API Docker image sets /app/terrain.
TERRAIN_DIR=
