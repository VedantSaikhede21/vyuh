# VYUH web environment — this file is the contract (CLAUDE.md §11).
# Copy to `.env.local`. Only NEXT_PUBLIC_* values reach the browser; never put secrets here.

# FastAPI base URL including /api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# local (dev-login against the API, works offline) | supabase (email + password via Supabase Auth)
NEXT_PUBLIC_AUTH_MODE=local

# Supabase Auth (only when NEXT_PUBLIC_AUTH_MODE=supabase). The anon key is public by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# true shows "Try demo" on the landing page (guest mode arrives in Phase 6)
NEXT_PUBLIC_GUEST_MODE=false
